# Copy this file to ".env" (same folder) and edit only if needed.
# A long random secret used to sign login sessions:
SECRET_KEY=please-change-this-to-some-long-random-text

# Server binding. 127.0.0.1 = this PC only (safe default).
# Use 0.0.0.0 to allow other devices on the shop Wi-Fi/LAN (never expose to the internet).
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Advanced: point the app at a different database later (SQLite file or a server DB).
# DATABASE_URL=sqlite:///C:/grocery_data/grocery.db